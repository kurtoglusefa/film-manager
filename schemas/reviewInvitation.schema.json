{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/reviewInvitation.schema.json",
  "title": "Review Invitation / Review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "filmId": { "type": "integer" },
    "reviewerId": { "type": "integer" },
    "completed": { "type": "boolean" },
    "reviewDate": { "type": "string", "format": "date" },
    "rating": { "type": "integer", "minimum": 0, "maximum": 10 },
    "review": { "type": "string", "maxLength": 1000 }
  },
  "required": ["filmId", "reviewerId", "completed"],

  "allOf": [
    {
      "if": { "properties": { "completed": { "const": true } }, "required": ["completed"] },
      "then": { "required": ["reviewDate", "rating", "review"] },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["reviewDate"] },
            { "required": ["rating"] },
            { "required": ["review"] }
          ]
        }
      }
    }
  ]
}
