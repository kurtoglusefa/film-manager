### Film Manager REST API Manual Tests (owner-only, no DB changes)
@baseUrl = http://localhost:3001
@userEmail = user.dsp@polito.it
@userPassword = password

# Fill these after running the earlier requests:
@myUserId = 0          # set from GET /api/sessions/current
@publicFilmId = 19      # set from the PUBLIC create response
@privateFilmId = 0     # set from the PRIVATE create response


# 0) Auth (owner)

### Login (owner)
# @name loginOwner
POST {{baseUrl}}/api/sessions
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### Who am I (owner) — copy the "id" here into @myUserId above
GET {{baseUrl}}/api/sessions/current



# 1) Public film happy path (owner invites THEMSELVES and completes)

### Create a PUBLIC film (no watchDate/rating/favorite for public)
POST {{baseUrl}}/api/films
Content-Type: application/json

{
  "title": "Public Demo",
  "private": false
}

# After this returns 201, copy its "id" into @publicFilmId at the top.

### Verify it’s visible via public endpoint
GET {{baseUrl}}/api/films/public/{{publicFilmId}}

### Invite MYSELF (owner) to review this public film
POST {{baseUrl}}/api/films/{{publicFilmId}}/reviews
Content-Type: application/json

{
  "reviewerId": {{myUserId}}
}

### See all reviews for that public film (should include a pending one)
GET {{baseUrl}}/api/films/public/{{publicFilmId}}/reviews

### Complete the review AS MYSELF (same session)
PUT {{baseUrl}}/api/films/{{publicFilmId}}/reviews/{{myUserId}}
Content-Type: application/json

{
  "completed": true,
  "reviewDate": "2025-11-09",
  "rating": 8,
  "review": "Owner self-review demo."
}

### Now the single review is completed
GET {{baseUrl}}/api/films/public/{{publicFilmId}}/reviews/{{myUserId}}

### (Optional) Films I’m invited to review (should include the film now)
GET {{baseUrl}}/api/films/reviews/me

### Clean up: delete the public film (owner can; service removes reviews first)
DELETE {{baseUrl}}/api/films/{{publicFilmId}}



####################################################################
# 2) Private film CRUD (owner)
####################################################################

### Create a PRIVATE film
POST {{baseUrl}}/api/films
Content-Type: application/json

{
  "title": "Private Demo",
  "private": true,
  "watchDate": "2025-11-08",
  "rating": 9,
  "favorite": true
}

# After this returns 201, copy its "id" into @privateFilmId at the top.

### Retrieve my private film via authenticated endpoint
GET {{baseUrl}}/api/films/{{privateFilmId}}

### Update the private film
PUT {{baseUrl}}/api/films/{{privateFilmId}}
Content-Type: application/json

{
  "id": {{privateFilmId}},
  "title": "Private Demo (Edited)",
  "private": true,
  "watchDate": "2025-11-09",
  "rating": 7,
  "favorite": false
}

### Get my private films (paginated)
GET {{baseUrl}}/api/films/me?page=1&pageSize=5

### Delete the private film
DELETE {{baseUrl}}/api/films/{{privateFilmId}}



####################################################################
# 3) Public catalogue (for sanity)
####################################################################

### List public films (paginated)
GET {{baseUrl}}/api/films/public?page=1&pageSize=5



####################################################################
# 4) Logout
####################################################################

DELETE {{baseUrl}}/api/sessions/current
