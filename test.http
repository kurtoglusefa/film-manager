###  Film Manager REST API Manual Tests
###  Server: http://localhost:3001
###  Cookies: VS Code REST Client keeps connect.sid automatically after login

@baseUrl = http://localhost:3001
@userEmail = user.dsp@polito.it
@userPassword = password
@samplePublicFilmId = 2
@sampleReviewerId = 2
@newFilmId = 999


####################################################################
# 1) Authentication
####################################################################

### Login
POST {{baseUrl}}/api/sessions
Content-Type: application/json

{
  "email": "frank.stein@polito.it",
  "password": "shelley97"
}

### Get current authenticated user
GET {{baseUrl}}/api/sessions/current

### Logout
DELETE {{baseUrl}}/api/sessions/current



####################################################################
# 2) Public Films (no auth required)
####################################################################

### List public films (paginated)
GET {{baseUrl}}/api/films/public?page=1&pageSize=5

### Get a single public film
GET {{baseUrl}}/api/films/public/{{samplePublicFilmId}}

### Get all reviews of a public film
GET {{baseUrl}}/api/films/public/{{samplePublicFilmId}}/reviews

### Get specific review of a public film
GET {{baseUrl}}/api/films/public/{{samplePublicFilmId}}/reviews/{{sampleReviewerId}}



####################################################################
# 3) My Films (requires login)
####################################################################

### Get my films
GET {{baseUrl}}/api/films/me?page=1&pageSize=5

### Create a new film (no id/owner in body)
POST {{baseUrl}}/api/films
Content-Type: application/json

{
  "title": "The Matrix Reloaded",
  "private": true,
  "watchDate": "2025-11-08",
  "rating": 9,
  "favorite": true
}

### Retrieve the newly created film (replace with actual id if different)
GET {{baseUrl}}/api/films/{{newFilmId}}

### Update the film (id must match path)
PUT {{baseUrl}}/api/films/{{newFilmId}}
Content-Type: application/json

{
  "id": {{newFilmId}},
  "title": "The Matrix Revolutions",
  "private": true,
  "watchDate": "2025-11-09",
  "rating": 8,
  "favorite": false
}

### Delete the film
DELETE {{baseUrl}}/api/films/{{newFilmId}}



####################################################################
# 4) Review Invitations (Owner actions; requires login)
####################################################################

### Invite reviewer to a public film (use one you own & is public)
POST {{baseUrl}}/api/films/{{samplePublicFilmId}}/reviews
Content-Type: application/json

{
  "reviewerId": {{sampleReviewerId}}
}

### Delete invitation (only if not completed)
DELETE {{baseUrl}}/api/films/{{samplePublicFilmId}}/reviews/{{sampleReviewerId}}

### Reviewer completes review (this endpoint requires the invited reviewer logged in)
PUT {{baseUrl}}/api/films/{{samplePublicFilmId}}/reviews/{{sampleReviewerId}}
Content-Type: application/json

{
  "completed": true,
  "reviewDate": "2025-11-09",
  "rating": 8,
  "review": "Great cinematography and score."
}



####################################################################
# 5) Films I’m invited to review (requires login as the reviewer)
####################################################################

GET {{baseUrl}}/api/films/reviews/me



####################################################################
# 6) Optional admin: auto-assign (requires auth; adjust service/rights)
####################################################################

POST {{baseUrl}}/api/reviews/auto-assign
